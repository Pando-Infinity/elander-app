# Staging / beta: opens the beta deployment of this repo.
HOST=www.beta.e-lander.xyz

# Android application id; also the Java package of the generated sources.
# Not xyz.e_lander.beta.twa: that id belongs to an earlier build signed with a key this repo
# does not have. public/.well-known/assetlinks.json keeps its entry so that build still verifies.
PACKAGE_ID=xyz.e_lander.app.dev

APP_NAME="E-Lander dev"
LAUNCHER_NAME="E-Lander dev"

# Bumped by hand per release; APP_VERSION_CODE only ever goes up.
APP_VERSION_NAME=1.0.0
APP_VERSION_CODE=1

# Resolved from twa/, git-ignored. Create once with keytool (README).
KEYSTORE_FILE=elander-staging.keystore
KEYSTORE_ALIAS=elander-staging

# Where bubblewrap reads the manifest and icons while generating. Defaults to https://$HOST.
# Set it in the shell instead (README); a value here overrides the shell.
# ASSET_ORIGIN=http://localhost:3000

# SHA-256 of the signing certificate(s), comma-separated, as printed by keytool -list -v.
# Also add it to public/.well-known/assetlinks.json (README, "Digital Asset Links").
SHA256_FINGERPRINT=9A:94:89:4C:BA:0A:1B:3E:94:81:A0:50:C9:8C:1F:73:BE:FD:80:D0:9B:04:C5:5B:44:8E:91:C0:2B:6A:2E:8B
