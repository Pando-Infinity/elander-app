# Production: opens the mainnet deployment of this repo (main branch).
HOST=app.e-lander.xyz

# Android application id. Permanent once published to the dApp Store.
PACKAGE_ID=xyz.elander.app

APP_NAME="E-Lander"

# Bumped by hand per release; APP_VERSION_CODE only ever goes up.
APP_VERSION_NAME=1.0.0
APP_VERSION_CODE=1

# Resolved from twa/, git-ignored. Create once with keytool (README).
KEYSTORE_FILE=elander-production.keystore
KEYSTORE_ALIAS=elander-production

# Expected SHA-256 of the signing certificate; scripts/build.sh fails if the APK differs.
SHA256_FINGERPRINT=E7:4A:49:EE:95:9B:6E:CD:C8:1C:E6:23:11:D7:E0:C1:CC:87:CA:A3:1B:A8:79:C9:F8:98:58:8F:04:7A:45:DF
